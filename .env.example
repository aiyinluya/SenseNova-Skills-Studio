# 复制为本目录下的 .env 后填入密钥（勿将 .env 提交到 Git）
#
# 创建 API Key：https://platform.sensenova.cn/console/keys
# Token 套餐说明：https://platform.sensenova.cn/token-plan

SN_BASE_URL=https://token.sensenova.cn/v1
SN_API_KEY=

# 可选：仅为某一能力单独配置密钥（留空则使用 SN_API_KEY）
# 注意：不要写 "SN_IMAGE_GEN_API_KEY=" 空行，会覆盖全局密钥导致生图失败
# SN_IMAGE_GEN_API_KEY=
# SN_VISION_API_KEY=
# SN_CHAT_API_KEY=

# 可选：覆盖默认模型
# SN_IMAGE_GEN_MODEL=sensenova-u1-fast
# SN_CHAT_MODEL=sensenova-6.7-flash-lite
# SN_VISION_MODEL=sensenova-6.7-flash-lite

# 可选：skills 目录不在仓库根时指定
# SN_SKILLS_ROOT=
